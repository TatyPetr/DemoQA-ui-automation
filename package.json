{
  "name": "demoqa-ui-automation",
  "version": "1.0.0",
  "description": "DemoQA UI and API automation project using Playwright and JavaScript",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:smoke": "playwright test --grep \"@smoke\"",
    "test:regression": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui:chromium": "playwright test tests/ui --project=chromium",
    "test:smoke:chromium": "playwright test --project=chromium --grep @smoke",
    "report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.51.0",
    "eslint": "^9.20.1",
    "globals": "^15.15.0",
    "prettier": "^3.5.0"
  }
}
